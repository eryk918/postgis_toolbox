<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>db_dialog</class>
 <widget class="QDialog" name="db_dialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>600</width>
    <height>550</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>PostGIS Toolbox - DB Manager</string>
  </property>
  <property name="sizeGripEnabled">
   <bool>true</bool>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="connections_groupbox">
     <property name="title">
